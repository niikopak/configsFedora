screenshots":[{"url":"https://addons.mozilla.org/user-media/version-previews/full/3871/3871520.png?modified=1636139409","width":680,"height":92,"thumbnailURL":"https://addons.mozilla.org/user-media/version-previews/thumbs/3871/3871520.png?modified=1636139409","thumbnailWidth":473,"thumbnailHeight":64},{"url":"https://addons.mozilla.org/user-media/version-previews/full/3871/3871521.svg?modified=1636139409","width":720,"height":92,"thumbnailURL":"https://addons.mozilla.org/user-media/version-previews/thumbs/3871/3871521.jpg?modified=1636139409","thumbnailWidth":720,"thumbnailHeight":92}],"contributionURL":"","averageRating":4.2857,"reviewCount":3,"reviewURL":"https://addons.mozilla.org/ru/firefox/addon/halloween2electricboogaloo/reviews/","updateDate":1636141424000},{"id":"{c70dad95-e512-43d5-afb2-89c978655ef7}","icons":{"32":"https://addons.mozilla.org/user-media/addon_icons/2893/2893321-32.png?modified=9202b708","64":"https://addons.mozilla.org/user-media/addon_icons/2893/2893321-64.png?modified=9202b708","128":"https://addons.mozilla.org/user-media/addon_icons/2893/2893321-128.png?modified=9202b708"},"name":"Backrooms Tab Manager","version":"1.0.2","sourceURI":"https://addons.mozilla.org/firefox/downloads/file/4427985/backrooms_tab_manager-1.0.2.xpi","homepageURL":null,"supportURL":"https://x.com/SixBangs","amoListingURL":"https://addons.mozilla.org/ru/firefox/addon/backrooms-tab-manager/","description":"Your abandoned tabs vanish into the backrooms. They're still there, somewhere, in the endless hallways...","fullDescription":"You have a problem, you know? That's just... it's so many tabs. And there's good stuff in there, so you can't just close them.\n\nWhen tabs get abandoned they don't just disappear - they fade into the backrooms, a liminal space where lost digital artifacts go to die. You can still find them there, trapped in an endless maze of beige monotony.\n\n    Automatically tracks the tabs you actually use, and the ones that are just taking up space\n    Sends your unused tabs to the backrooms after a configurable time period\n    Creepy institutional interface that perfectly captures that liminal space vibe\n    Lets you rescue tabs from digital purgatory if you actually need them\n    Built-in notification system that feels like getting messages from another dimension\n\n\nPerfect for tab hoarders who need to get themselves together but don't want to eliminate their tabs into oblivion. Your tabs aren't gone, they're just... somewhere else. In the endless fluorescent hallways. Waiting.\n\nGuaranteed to make managing your tabs feel like a psychological horror game.\n\nP.S.: If you start getting notifications from tabs you don't remember opening, that's probably fine. Probably.","weeklyDownloads":1,"type":"extension","creator":{"name":"SixBangs","url":"https://addons.mozilla.org/ru/firefox/user/18800454/"},"developers":[],"screenshots":[{"url":"https://addons.mozilla.org/user-media/previews/full/312/312776.png?modified=1738206186","width":1280,"height":800,"thumbnailURL":"https://addons.mozilla.org/user-media/previews/thumbs/312/312776.jpg?modified=1738206186","thumbnailWidth":533,"thumbnailHeight":333,"caption":"4 tabs vanished to the backrooms"}],"contributionURL":"","averageRating":4.3333,"reviewCount":3,"reviewURL":"https://addons.mozilla.org/ru/firefox/addon/backrooms-tab-manager/reviews/","updateDate":1738206318000},{"id":"{bf3f6cfb-e9ca-4282-8b68-9d219e5732c4}","icons":{"32":"https://addons.mozilla.org/static-server/img/addon-icons/default-32.png","64":"https://addons.mozilla.org/static-server/img/addon-icons/default-64.png","128":"https://addons.mozilla.org/static-server/img/addon-icons/default-128.png"},"name":"The Backrooms","version":"1.0","sourceURI":"https://addons.mozilla.org/firefox/downloads/file/4850820/the_backrooms-1.0.xpi","homepageURL":null,"supportURL":null,"amoListingURL":"https://addons.mozilla.org/ru/firefox/addon/the-backrooms/","description":"Based of Kane Pixel Backrooms serie and movie","fullDescription":null,"weeklyDownloads":21,"type":"theme","creator":{"name":"daniel","url":"https://addons.mozilla.org/ru/firefox/user/19984250/"},"developers":[],"screenshots":[{"url":"https://addons.mozilla.org/user-media/version-previews/full/4083/4083462.png?modified=1781457440","width":680,"height":92,"thumbnailURL":"https://addons.mozilla.org/user-media/version-previews/thumbs/4083/4083462.png?modified=1781457440","thumbnailWidth":473,"thumbnailHeight":64},{"url":"https://addons.mozilla.org/user-media/version-previews/full/4083/4083463.svg?modified=1781457440","width":720,"height":92,"thumbnailURL":"https://addons.mozilla.org/user-media/version-previews/thumbs/4083/4083463.jpg?modified=1781457440","thumbnailWidth":720,"thumbnailHeight":92}],"contributionURL":"","averageRating":4.5,"reviewCount":1,"reviewURL":"https://addons.mozilla.org/ru/firefox/addon/the-backrooms/reviews/","updateDate":1781476995000}]}